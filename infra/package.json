{
  "name": "devops-red-line-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure for DevOps Red Line (ECS Fargate, ALB, RDS, Lambda, Bedrock)",
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth --strict",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "aws-cdk-lib": "2.277.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1169.0",
    "@aws-sdk/client-rds": "3.1169.0",
    "@aws-sdk/client-secrets-manager": "3.1169.0",
    "@aws-sdk/client-sns": "3.1169.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1148.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
