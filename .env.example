# Environment Variables Template
# Copy this file to .env and update the values for local development

# =============================================================================
# Backend Configuration (Django)
# =============================================================================

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=odc
POSTGRES_PASSWORD=odc123
POSTGRES_DB=odcdb

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True

# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True

# =============================================================================
# Frontend Configuration (React)
# =============================================================================

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api

# Application Settings  
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================

# PostgreSQL Database
POSTGRES_USER=odc
POSTGRES_PASSWORD=odc123
POSTGRES_DB=odcdb

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker Compose settings
COMPOSE_PROJECT_NAME=devops-red-line

# =============================================================================
# Kubernetes Configuration
# =============================================================================

# Ingress Configuration
INGRESS_HOST=devops-red-line.local

# =============================================================================
# Development Tools
# =============================================================================

# SonarQube
SONAR_HOST_URL=http://localhost:9000
SONAR_LOGIN=your-sonar-token

# Jenkins
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_PASSWORD=admin

# =============================================================================
# Production Overrides (for .env.production)
# =============================================================================

# Production Django Settings
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com
# DJANGO_SECRET_KEY=your-production-secret-key

# Production Database
# DB_HOST=your-production-db-host
# POSTGRES_PASSWORD=your-secure-production-password

# Production Frontend
# REACT_APP_API_URL=https://your-domain.com/api
# REACT_APP_ENV=production
# REACT_APP_DEBUG=false

# SSL Configuration
# SSL_CERT_PATH=/path/to/your/cert.pem
# SSL_KEY_PATH=/path/to/your/key.pem
